# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Runtime artifacts (regenerated each run)
state/
output/
run-log/

# Collected listings (only the placeholder sample.jsonl is tracked)
inputs/collected-*.jsonl

# Evaluation results (regenerated by evaluation/run_all.py; dir kept via .gitkeep)
evaluation/results/*.json
evaluation/results/*.jsonl
!evaluation/results/.gitkeep

# Autoresearch generated artifacts
autoresearch/holdout/
autoresearch/cost_log.json

# OS
.DS_Store
